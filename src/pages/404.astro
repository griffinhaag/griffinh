---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import capybara from '../assets/sleeping-capybara.jpg';
---

<Layout title="Page not found, Griffin Haag">
  <section class="lost relative isolate flex min-h-[100svh] flex-col overflow-hidden">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <Image src={capybara} alt="" widths={[800, 1280, 1920, 2752, 3600, 4608]} sizes="(max-aspect-ratio: 1376/768) 180svh, 100vw" format="webp" quality={80} loading="eager" class="size-full object-cover" />
      <div class="shade absolute inset-0"></div>
    </div>
    <div class="lost-copy wrap pb-16">
      <p class="font-mono text-sm text-muted">404</p>
      <h1 class="mt-3 font-display text-[clamp(3rem,10vw,7rem)] leading-[0.9] font-semibold tracking-[-0.04em]">Off the map<span class="dot">.</span></h1>
      <p class="mt-6 max-w-md text-lg text-frost/80">You wandered off the trail map. Nothing out here but lily pads and a very sleepy capybara.</p>
      <div class="mt-8"><a href="/" class="btn btn-primary">Take the gondola home</a></div>
    </div>
  </section>
</Layout>

<style>
  /* Landscape: the capybara sleeps on the right, so darken the left where the text sits. */
  .lost { justify-content: center; }
  .lost-copy { padding-top: 6rem; }
  .lost img { object-position: 30% 50%; }
  .shade {
    background:
      linear-gradient(90deg, var(--color-ink) 0%, color-mix(in oklab, var(--color-ink) 82%, transparent) 30%, color-mix(in oklab, var(--color-ink) 25%, transparent) 62%, transparent 80%),
      linear-gradient(180deg, color-mix(in oklab, var(--color-ink) 70%, transparent) 0%, transparent 22%, transparent 75%, var(--color-ink) 100%);
  }
  /* Squarer landscape screens (iPads, 4:3 laptops) crop more off the sides, so slide right to keep its face in. */
  @media (min-aspect-ratio: 1/1) and (max-aspect-ratio: 3/2) {
    .lost img { object-position: 62% 50%; }
  }
  /* Portrait phones and tablets: text up top, the capybara's face underneath it. */
  @media (max-aspect-ratio: 1/1) {
    .lost { justify-content: flex-start; }
    .lost-copy { padding-top: clamp(8rem, 16svh, 12rem); }
    .lost img { object-position: 89% 50%; }
    .shade {
      background: linear-gradient(180deg, var(--color-ink) 0%, color-mix(in oklab, var(--color-ink) 85%, transparent) 38%, color-mix(in oklab, var(--color-ink) 15%, transparent) 62%, transparent 80%, var(--color-ink) 100%);
    }
  }
</style>
