---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found, Griffin Haag">
  <section class="wrap flex min-h-[80svh] flex-col justify-center pt-24">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-3 font-display text-[clamp(3rem,10vw,7rem)] leading-[0.9] font-semibold tracking-[-0.04em]">Nothing here<span class="dot">.</span></h1>
    <p class="mt-6 max-w-md text-lg text-muted">That page doesn’t exist. It may have moved when this site left Wix.</p>
    <div class="mt-8"><a href="/" class="btn btn-primary">Go to the homepage</a></div>
  </section>
</Layout>
