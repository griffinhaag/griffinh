---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import capybara from '../assets/sleeping-capybara.jpg';
---

<Layout title="Page not found, Griffin Haag">
  <section class="lost relative isolate flex min-h-[100svh] flex-col justify-start overflow-hidden md:justify-center">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <Image src={capybara} alt="" widths={[640, 960, 1273]} sizes="100vw" format="webp" quality={82} loading="eager" class="size-full object-cover" />
      <div class="shade absolute inset-0"></div>
    </div>
    <div class="wrap pt-32 pb-16 md:pt-24">
      <p class="font-mono text-sm text-muted">404</p>
      <h1 class="mt-3 font-display text-[clamp(3rem,10vw,7rem)] leading-[0.9] font-semibold tracking-[-0.04em]">Off the map<span class="dot">.</span></h1>
      <p class="mt-6 max-w-md text-lg text-frost/80">You skied past the edge of the trail map. There’s nothing out here but fresh powder and the occasional capybara.</p>
      <div class="mt-8"><a href="/" class="btn btn-primary">Take the gondola home</a></div>
    </div>
  </section>
</Layout>

<style>
  /* The capybara sleeps on the right, so keep it in frame and darken the left where the text sits. */
  .lost img { object-position: 72% 50%; }
  .shade {
    background:
      linear-gradient(90deg, var(--color-ink) 0%, color-mix(in oklab, var(--color-ink) 82%, transparent) 30%, color-mix(in oklab, var(--color-ink) 25%, transparent) 62%, transparent 80%),
      linear-gradient(180deg, color-mix(in oklab, var(--color-ink) 70%, transparent) 0%, transparent 22%, transparent 75%, var(--color-ink) 100%);
  }
  @media (min-width: 768px) and (max-aspect-ratio: 5/4) {
    .lost img { object-position: 88% 50%; }
  }
  @media (max-width: 767px) {
    /* On a phone the text sits up top and the capybara's face shows underneath it. */
    .lost img { object-position: 89% 50%; }
    .shade {
      background: linear-gradient(180deg, var(--color-ink) 0%, color-mix(in oklab, var(--color-ink) 85%, transparent) 38%, color-mix(in oklab, var(--color-ink) 15%, transparent) 62%, transparent 80%, var(--color-ink) 100%);
    }
  }
</style>
