---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found, Griffin Haag">
  <section class="wrap flex min-h-[80svh] flex-col justify-center pt-24">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-3 font-display text-[clamp(3rem,10vw,7rem)] leading-[0.9] font-semibold tracking-[-0.04em]">Off the map<span class="dot">.</span></h1>
    <p class="mt-6 max-w-md text-lg text-muted">You skied past the edge of the trail map. There’s nothing out here but fresh powder and the occasional capybara.</p>
    <div class="mt-8"><a href="/" class="btn btn-primary">Take the gondola home</a></div>
  </section>
</Layout>
