---
// The site's figure (skier in the hero, climber in "Where I've been") peeking over the top edge of a
// project card: white helmet and white gloves gripping the edge. The accessories vary per card:
// `cap` is a graduation cap, with the collar of a Dunwoody-red tee showing at the neck;
// `snapback` swaps the helmet for a cream 8-ball snapback with
// 3D glasses (white frame, red and blue lenses).
interface Props {
  hat?: 'cap' | 'snapback';
}
const { hat } = Astro.props;
const DARK = '#151a29';
const HELMET = '#dfe5f1';
const SKIN = '#e9bf9b';
const TRIM = '#8a93ad';
const GOLD = '#f0b03a';
const SHIRT = '#800020'; // DayONE / Dunwoody red
---

<span class="peek" aria-hidden="true">
  <span class="peek-back">
    <svg viewBox="0 0 56 30" width="56" height="30">
      <g class="peek-face">
        {hat === 'cap' && (
          <g>
            <path d="M17 30.5C17.6 28.6 20.6 27.6 23.6 27.4h8.8c3 .2 6 1.2 6.6 3.1Z" fill={SHIRT} />
            <path d="M25.2 28.2q2.8 2 5.6 0" fill="none" stroke="#f4f6fb" stroke-width="0.7" stroke-linecap="round" />
          </g>
        )}
        <g transform={hat === 'cap' ? 'translate(0 -6)' : undefined}>
          <circle cx="28" cy="27.5" r="8" fill={SKIN} />
          {hat !== 'snapback' && <path d="M19.2 26a8.8 8.8 0 0 1 17.6 0Z" fill={HELMET} />}
          {hat === 'cap' && (
            <g>
              <path d="M17.5 18.4 28 14.2l10.5 4.2L28 22.6Z" fill={DARK} stroke={TRIM} stroke-width="0.6" stroke-linejoin="round" />
              <path d="M36.4 18.6v5.4" stroke={GOLD} stroke-width="1" stroke-linecap="round" />
              <circle cx="36.4" cy="24.6" r="1" fill={GOLD} />
            </g>
          )}
          {hat === 'snapback' && (
            <g>
              <path d="M21 25.9h14a.8.8 0 0 1 .8.8v2.6a.8.8 0 0 1-.8.8H21a.8.8 0 0 1-.8-.8v-2.6a.8.8 0 0 1 .8-.8Z" fill="#f4f6fb" stroke={DARK} stroke-width="0.6" />
              <rect x="21.4" y="26.7" width="5.6" height="2.2" rx="0.6" fill="#e0483f" />
              <rect x="29" y="26.7" width="5.6" height="2.2" rx="0.6" fill="#2a4fa8" />
              <path d="M22.2 27.3h2.2M29.8 27.3h2.2" stroke="#ffffff" stroke-opacity="0.55" stroke-width="0.45" stroke-linecap="round" />
              <path d="M19.6 22.2C19.6 17.2 23.2 14.6 28 14.6s8.4 2.6 8.4 7.6Z" fill="#efe9da" stroke={DARK} stroke-width="0.5" stroke-linejoin="round" />
              <path d="M28 14.8v7.2" stroke="#d8d0bb" stroke-width="0.4" />
              <circle cx="28" cy="14.5" r="0.6" fill="#5a4b55" />
              <circle cx="28" cy="18.7" r="2.5" fill={DARK} />
              <circle cx="28" cy="18.3" r="1.05" fill="#f4f6fb" />
              <circle cx="28" cy="17.95" r="0.3" fill="none" stroke={DARK} stroke-width="0.22" />
              <circle cx="28" cy="18.6" r="0.36" fill="none" stroke={DARK} stroke-width="0.22" />
              <path d="M18.6 22.2h18.8a.6.6 0 0 1 .6.6v.4a.8.8 0 0 1-.8.8H18.8a.8.8 0 0 1-.8-.8v-.4a.6.6 0 0 1 .6-.6Z" fill="#5a4b55" stroke={DARK} stroke-width="0.4" />
            </g>
          )}
          {hat !== 'snapback' && (
            <g class="peek-eyes" fill={DARK}><circle cx="25" cy="28.4" r="1" /><circle cx="31" cy="28.4" r="1" /></g>
          )}
        </g>
      </g>
    </svg>
  </span>
  <span class="peek-front">
    <svg viewBox="0 0 56 34" width="56" height="34">
      <g class="hand-l"><rect x="14" y="26" width="7.5" height="6" rx="2.6" fill={HELMET} /><path d="M16.5 29.2v2.2M19 29.2v2.2" stroke={TRIM} stroke-width="0.5" stroke-linecap="round" /></g>
      <g class="hand-r"><rect x="34.5" y="26" width="7.5" height="6" rx="2.6" fill={HELMET} /><path d="M37.0 29.2v2.2M39.5 29.2v2.2" stroke={TRIM} stroke-width="0.5" stroke-linecap="round" /></g>
    </svg>
  </span>
</span>

<style>
  /* A figure peeks over the top-left edge of the active project card. The clip box ends a few
     pixels into the card, so the hands overlap the border and the rest is hidden below it. */
  /* The head layer is clipped exactly at the card's top border (behind the card); the hands
     layer extends 3px past it to overlap the edge. Both are hidden below their clip line
     until the card is active. top is -31px: 30px of drawing plus the 1px border. */
  .peek { position: absolute; left: 2.5rem; top: -31px; width: 56px; height: 34px; pointer-events: none; z-index: 1; }
  .peek-back, .peek-front { position: absolute; left: 0; top: 0; width: 56px; overflow: hidden; }
  .peek-back { height: 30px; }
  .peek-front { height: 34px; }
  .peek svg { display: block; transform: translateY(105%); transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
  :global(.feature.peeking) .peek-front svg { transform: translateY(0); }
  :global(.feature.peeking) .peek-back svg { transform: translateY(0); transition-delay: 140ms; transition-duration: 560ms; transition-timing-function: cubic-bezier(0.34, 1.35, 0.64, 1); }
  /* Scaled up from the grip line (31px down) so the hands stay on the card's edge. */
  .peek { transform: scale(1.25); transform-origin: 0 31px; }
  .peek-face, .hand-r, .hand-l { transform-box: fill-box; }
  .peek-face { transform-origin: 50% 100%; }
  .hand-r, .hand-l { transform-origin: 50% 100%; }
  .peek-eyes { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.feature.peeking) .peek-eyes { animation: peek-blink 3.8s 1.2s infinite; }
    /* Once raised, the figure periodically looks around and waves. */
    :global(.feature.peeking) .peek-face { animation: peek-look 5.2s 0.9s ease-in-out infinite; }
    :global(.feature.peeking) .hand-r { animation: peek-wave 5.2s 1.1s ease-in-out infinite; }
    :global(.feature.peeking) .hand-l { animation: peek-grip 5.2s 1.1s ease-in-out infinite; }
  }
  @keyframes peek-look {
    0%, 30% { transform: rotate(0deg); }
    38%, 50% { transform: rotate(-10deg); }
    58%, 70% { transform: rotate(8deg); }
    78%, 100% { transform: rotate(0deg); }
  }
  @keyframes peek-wave {
    0%, 76% { transform: translateY(0) rotate(0deg); }
    80% { transform: translateY(-6px) rotate(-14deg); }
    84% { transform: translateY(-6px) rotate(12deg); }
    88% { transform: translateY(-6px) rotate(-14deg); }
    92% { transform: translateY(-6px) rotate(10deg); }
    97%, 100% { transform: translateY(0) rotate(0deg); }
  }
  @keyframes peek-grip { 0%, 78%, 96%, 100% { transform: translateY(0); } 86% { transform: translateY(0.6px); } }
  @keyframes peek-blink { 0%, 94%, 100% { transform: scaleY(1); } 97% { transform: scaleY(0.15); } }
  @media (prefers-reduced-motion: reduce) {
    .peek svg { transition: opacity 300ms; transform: none; opacity: 0; }
    :global(.feature.peeking) .peek svg { opacity: 1; transform: none; }
    :global(.feature.peeking) .peek-eyes { animation: none; }
  }
</style>
