---
import Section from './Section.astro';
import { experience, origins } from '../data/site';
---

<Section id="experience" title="Where I’ve been" lede="Newest first. The early years are tucked away at the bottom.">
  <!-- A rocky lip under the hero's mountains. The climber's rope is anchored to it. -->
  <svg slot="top" class="ledge" height="110" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="ledge-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#121a30" stop-opacity="0" />
        <stop offset="0.45" stop-color="#121a30" stop-opacity="0.85" />
        <stop offset="1" stop-color="#18213b" />
      </linearGradient>
    </defs>
    <path class="rock" fill="url(#ledge-fill)" />
    <path class="lip" fill="none" stroke="#9fb2cf" stroke-opacity="0.16" stroke-width="1" />
  </svg>
  <ol class="timeline" data-timeline>
    {experience.map((job) => (
      <li class={`item ${job.when.includes('present') ? 'current' : ''}`}>
        <div class="body">
        <p class="when meta text-sm">{job.when}</p>
        <h3 class="font-display text-2xl font-medium leading-tight tracking-tight md:text-[1.7rem]">{job.title}</h3>
        <p class="mt-1 text-blue-soft">
          {job.org}
          {job.where && <span class="text-muted">, {job.where}</span>}
        </p>
        <ul class="mt-3 space-y-1.5 text-muted">
          {job.points.map((p) => <li>{p}</li>)}
        </ul>
        </div>
      </li>
    ))}
  </ol>

  <details class="origins mt-2 ml-7 rounded-xl border border-line md:ml-9">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-lg font-medium">
      How it started
      <span class="chev grid size-7 place-items-center rounded-full border border-line text-muted" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </summary>
    <ul class="space-y-4 px-5 pb-5">
      {origins.map((o) => (
        <li class="grid gap-1 sm:grid-cols-[7.5rem_1fr] sm:gap-4">
          <span class="text-sm text-muted sm:pt-0.5">{o.when}</span>
          <span>{o.text}</span>
        </li>
      ))}
    </ul>
  </details>
</Section>

<style>
  .ledge { position: absolute; top: 0; left: 0; display: block; pointer-events: none; }
  .timeline { position: relative; }
  .timeline :global(.climb-layer) { position: absolute; top: 0; left: 0; overflow: visible; pointer-events: none; z-index: 2; }
  .timeline :global(.climb-layer .beam) { opacity: 0; transition: opacity 400ms ease; }
  .timeline :global(.climb-layer.beam-on .beam) { opacity: 1; }
  .timeline :global(.climb-layer .lens) { fill: #6b7391; transition: fill 300ms; }
  .timeline :global(.climb-layer.beam-on .lens) { fill: #fff2cc; }
  .timeline :global(.climb-layer .arms-up),
  .timeline :global(.climb-layer .arms-back),
  .timeline :global(.climb-layer.right-side .arms-down) { display: none; }
  .timeline :global(.climb-layer.right-side .arms-back) { display: inline; }
  .timeline :global(.climb-layer.ascending .arms-back) { display: none; }
  .timeline :global(.climb-layer.ascending .arms-up) { display: inline; }
  .timeline :global(.climb-layer.ascending .arms-down) { display: none; }
  /* The flashlight's glow on the entry you're reading */
  .item::after {
    content: '';
    position: absolute;
    inset: -0.9rem -0.5rem 1.6rem 1rem;
    border-radius: 1.1rem;
    background: radial-gradient(ellipse 55% 70% at 0% 28%, rgba(255, 233, 186, 0.1), transparent 62%);
    opacity: 0;
    transition: opacity 500ms ease;
    pointer-events: none;
  }
  .item.lit::after { opacity: 1; }
  .item .body { transition: border-color 500ms ease, box-shadow 500ms ease; }
  .item.lit.current .body { border-color: rgba(255, 233, 186, 0.28); box-shadow: 0 0 40px -18px rgba(255, 233, 186, 0.35); }
  .item.lit h3 { color: #fff; }
  .item h3 { transition: color 400ms ease; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.6rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-wine), var(--color-line) 30%);
  }
  .item { position: relative; padding-left: 1.75rem; padding-bottom: 2.75rem; }
  @media (min-width: 768px) { .item { padding-left: 2.25rem; } }
  .item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-ink);
    border: 1.5px solid var(--color-mist);
  }
  /* Current roles get a panel, so they read first. */
  .item.current .body {
    margin-top: -0.85rem;
    padding: 0.85rem 1.1rem 1rem;
    border-radius: 1rem;
    border: 1px solid var(--color-line);
    background: linear-gradient(180deg, #172039, #121a30);
  }
  .item.current::before { top: 0.45rem; }
  .item.current::before {
    background: var(--color-wine);
    border-color: var(--color-wine);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-wine) 25%, transparent);
  }

  .origins summary::-webkit-details-marker { display: none; }
  .chev { transition: transform 250ms var(--ease-out-quint); }
  .origins[open] .chev { transform: rotate(180deg); }
  .origins[open] ul { animation: open 300ms var(--ease-out-quint); }
  @keyframes open { from { opacity: 0; transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) {
    .origins[open] ul { animation: none; }
  }
</style>

<script>
  import { initClimber } from '../scripts/climber';
  const section = document.getElementById('experience');
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const ledge = document.querySelector<SVGSVGElement>('#experience .ledge');
  if (section && timeline && ledge) initClimber(section, timeline, ledge, document.getElementById('projects'));
</script>
