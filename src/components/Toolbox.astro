---
import Section from './Section.astro';
import { toolbox } from '../data/site';
---

<Section id="toolbox" title="Toolbox" lede="Pick any tool to see where I’ve used it." attrs={{ 'data-toolbox': '' }}>
  <div slot="aside" class="used panel panel-sm mt-6 min-h-[5.5rem]" aria-live="polite">
    <p class="meta text-sm" data-used-label>Where I’ve used it</p>
    <p class="mt-1 font-display text-lg leading-snug" data-used-list>Nothing picked yet.</p>
  </div>

  <!-- One compact panel: a row per group instead of four separate boxes. -->
  <div class="panel panel-sm divide-y divide-line !py-1">
    {toolbox.map((g) => (
      <div class="grid gap-x-6 gap-y-2.5 py-4 sm:grid-cols-[9.5rem_1fr] sm:items-baseline">
        <h3 class="font-display text-lg font-medium">{g.group}</h3>
        <ul class="flex flex-wrap gap-2">
          {g.tools.map((t) => (
            <li>
              <button type="button" class="tool rounded-lg border border-line px-3 py-1.5 text-[0.92rem] transition-colors" data-tool={t.name} data-used={t.used.join('|')} aria-pressed="false">
                {t.name}
              </button>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>

<style>
  .tool[aria-pressed='true'] {
    border-color: var(--color-wine);
    background: color-mix(in oklab, var(--color-wine) 12%, transparent);
  }
  @media (hover: hover) {
    .tool:hover { border-color: var(--color-muted); }
  }
  /* Below the two-column layout the panel sits above the tools, so tapping one near the bottom
     would update it off-screen. Let it stick under the nav while you browse instead. */
  @media (max-width: 1023px) {
    :global([data-toolbox] .split) { row-gap: 0; }
    :global([data-toolbox] .split > header) { display: contents; }
    :global([data-toolbox] .split > div) { margin-top: 1rem; }
    .used { position: sticky; top: 4.75rem; z-index: 5; align-self: start; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-toolbox]');
  if (root) {
    const label = root.querySelector<HTMLElement>('[data-used-label]')!;
    const list = root.querySelector<HTMLElement>('[data-used-list]')!;
    const tools = root.querySelectorAll<HTMLButtonElement>('[data-tool]');
    const select = (btn: HTMLButtonElement) => {
      tools.forEach((t) => t.setAttribute('aria-pressed', String(t === btn)));
      label.textContent = `Where I’ve used ${btn.dataset.tool}`;
      list.textContent = btn.dataset.used!.split('|').join(', ');
    };
    tools.forEach((btn) => {
      btn.addEventListener('click', () => select(btn));
      btn.addEventListener('focus', () => select(btn));
      btn.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') select(btn);
      });
    });
  }
</script>
