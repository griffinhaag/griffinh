---
import { links } from '../data/site';
---

<section id="top" class="hero relative isolate flex touch-pan-y min-h-[100svh] flex-col justify-center overflow-hidden pt-28 pb-16 md:pt-32 md:pb-20">
  <canvas id="mountains" class="absolute inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
  <div class="hero-fade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="wrap">
    <h1 class="name font-display font-semibold">
      <span class="line"><span>Griffin</span></span>
      <span class="line"><span>Haag<span id="hub-dot" class="dot">.</span></span></span>
    </h1>
    <p class="intro mt-8 max-w-[36rem] pr-9 text-lg text-muted sm:pr-0 md:text-xl">
      <span class="text-text">I’m a full-stack developer in Minneapolis.</span> By day I work on C# services and cloud infrastructure at
      KorTerra. The rest of the time I’m studying computer science at the U&nbsp;of&nbsp;M or adding something new to the party games I built for my friends.
    </p>
    <div class="actions mt-9 flex flex-wrap items-center justify-between gap-x-6 gap-y-5">
      <div class="flex flex-wrap gap-3">
        <a href="#projects" class="btn btn-primary">See my work</a>
        <a href={links.resume} class="btn btn-ghost" target="_blank" rel="noopener">Résumé (PDF)</a>
      </div>
      <p class="hint" aria-hidden="true"><span class="hint-dot"></span><span data-hint-text>Hover over the mountains or ski them.</span></p>
    </div>
  </div>
</section>

<style>
  .hero-fade {
    background: linear-gradient(to bottom, transparent 80%, color-mix(in oklab, var(--color-ink) 60%, transparent) 92%, var(--color-ink));
  }
  .name {
    /* Scales with height too, so the name fits under the nav on short windows. */
    font-size: clamp(4rem, min(14.5vw, 22svh), 11.25rem);
    line-height: 0.84;
    letter-spacing: -0.045em;
  }
  /* Extra padding so ascenders and the g's descender aren't clipped by the reveal mask. */
  .line { display: block; overflow: hidden; padding: 0.1em 0.12em 0.2em 0; margin-bottom: -0.3em; }
  .line:first-child { margin-top: -0.1em; }
  .line:last-child { margin-bottom: -0.05em; }
  /* Cool snow white, not pure white, to match the night scene. */
  .line > span { display: inline-block; color: #dfe5f1; text-shadow: 0 2px 28px rgba(11, 16, 32, 0.55); }
  #hub-dot { cursor: pointer; }
  /* The hint starts large, then settles to its resting size; it stays until the skier is grabbed. */
  .hint {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.85rem 0.45rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-mist) 30%, transparent);
    background: color-mix(in oklab, var(--color-ink) 55%, transparent);
    font-size: 0.85rem;
    line-height: 1.2;
    color: var(--color-text);
    transform-origin: left center;
    transition: transform 700ms var(--ease-out-quint), opacity 500ms ease, box-shadow 700ms ease, border-color 700ms ease;
  }
  @media (min-width: 768px) { .hint { transform-origin: right center; } }
  .hint.big {
    transform: scale(1.3);
    border-color: color-mix(in oklab, var(--color-blue-soft) 45%, transparent);
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--color-blue-soft) 10%, transparent), 0 0 32px -6px color-mix(in oklab, var(--color-blue-soft) 45%, transparent);
  }
  .hint.done { opacity: 0; transform: scale(0.94); pointer-events: none; }
  .hint-dot { width: 7px; height: 7px; flex: none; border-radius: 50%; background: var(--color-blue-soft); box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-blue-soft) 55%, transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .hint-dot { animation: hint-pulse 1.8s ease-out infinite; }
    .hint { animation: fade 700ms ease-out 900ms both; }
  }
  @keyframes hint-pulse { 70%, 100% { box-shadow: 0 0 0 7px transparent; } }
  /* Keeps the intro readable where it crosses the ridge, without a visible box. */
  .intro, .actions { text-shadow: 0 1px 14px rgba(11, 16, 32, 0.95), 0 0 2px rgba(11, 16, 32, 0.8); }

  /* Entrance sequence: the name rises into place, then the scene and remaining content fade in. */
  @media (prefers-reduced-motion: no-preference) {
    .line > span { animation: rise 900ms var(--ease-out-quint) both; }
    .line:nth-child(2) > span { animation-delay: 90ms; }
    .intro, .actions { animation: fade 700ms ease-out 800ms both; }
    #mountains { animation: fade 1400ms ease-out 400ms both; }
  }
  @keyframes rise { from { transform: translateY(105%); } }
  @keyframes fade { from { opacity: 0; } }
</style>

<script>
  import { initMountains } from '../scripts/mountains';
  const canvas = document.getElementById('mountains') as HTMLCanvasElement;
  const dot = document.getElementById('hub-dot')!;
  const intro = document.querySelector<HTMLElement>('.intro')!;
  const actions = document.querySelector<HTMLElement>('.actions > div')!;
  // The letters themselves, not the full-width heading box.
  const nameLines = [...document.querySelectorAll<HTMLElement>('.name .line > span')];
  const hintEl = document.querySelector<HTMLElement>('.hint')!;
  const scene = initMountains(canvas, dot, { clear: [intro, actions], avoid: nameLines });
  (window as any).__scene = scene;
  dot.addEventListener('click', () => scene.dropFromHub());
  const hero = document.getElementById('top')!;
  // Hint: starts large, settles after a delay, and hides once the skier is grabbed.
  const hintText = hintEl.querySelector<HTMLElement>('[data-hint-text]')!;
  hintEl.classList.add('big');
  setTimeout(() => hintEl.classList.remove('big'), 2600);
  addEventListener('skier:grabbed', () => hintEl.classList.add('done'), { once: true });
  // Shown only when this screen has a skier; worded for touch on touch screens.
  const syncHint = () => {
    hintText.textContent = matchMedia('(pointer: coarse)').matches ? 'Drag the skier down the mountain.' : 'Hover over the mountains or ski them.';
    hintEl.style.visibility = scene.runInfo() ? '' : 'hidden';
  };
  requestAnimationFrame(syncHint);
  let hintTimer = 0;
  addEventListener('resize', () => {
    clearTimeout(hintTimer);
    hintTimer = window.setTimeout(syncHint, 300);
  });
  // Scroll hand-off: past the top of the hero, the skier runs down to the gondola and becomes the
  // climber in "Where I've been"; back at the top, the skier returns to the summit.
  // <html data-skier> holds the state for the climber: 'here', 'away', or 'none' (no skier).
  const root = document.documentElement;
  const setSkier = (v: string) => {
    if (root.dataset.skier === v) return;
    root.dataset.skier = v;
    dispatchEvent(new Event('skier:' + v));
  };
  addEventListener('skier:away', () => setSkier('away'));
  let handoffTick = 0;
  const handoff = () => {
    handoffTick = 0;
    if (!scene.runInfo()) return setSkier('none'); // screens without a ski run
    // Fraction of the hero scrolled past: 0 at the top of the page, 1 once the hero is fully off screen.
    const r = hero.getBoundingClientRect();
    const f = Math.max(0, -r.top / r.height);
    const state = root.dataset.skier;
    // The run starts as soon as scrolling begins and tracks the scroll, reaching the gondola base about
    // when "Where I've been" comes into view. Back at the very top the skier returns to the summit.
    scene.followScroll((f - 0.02) / 0.5);
    if (f > 0.02 && state === 'here') {
      // Hand off at once only when the skier has scrolled out of view, so a fast flick still shows the run.
      const st = scene.skierState();
      const res = scene.skiAway(f >= 1 || r.top + st.y < -10);
      if (res === 'away' || res === 'none') setSkier(res === 'none' ? 'none' : 'away');
      // Mid-ride or mid-drag: check again shortly, even if scrolling stops.
      else if (res === 'busy') setTimeout(() => { if (!handoffTick) handoffTick = requestAnimationFrame(handoff); }, 500);
    } else if (f < 0.005 && state !== 'here') {
      scene.comeBack();
      setSkier('here');
    }
  };
  root.dataset.skier = 'here';
  addEventListener('scroll', () => { if (!handoffTick) handoffTick = requestAnimationFrame(handoff); }, { passive: true });
  addEventListener('resize', () => { if (!handoffTick) handoffTick = requestAnimationFrame(handoff); });
  requestAnimationFrame(handoff);
  // Re-measure the period once the name finishes rising into place.
  document.querySelector('.name')?.addEventListener('animationend', () => scene.remeasure());
</script>
