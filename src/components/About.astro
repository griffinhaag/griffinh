---
import Section from './Section.astro';
import { facts, links } from '../data/site';
---

<Section id="about" title="About me" band>
  <div slot="aside" class="mt-10 max-w-sm sm:grid sm:max-w-none sm:grid-cols-[minmax(0,17rem)_minmax(0,1fr)] sm:items-end sm:gap-6 lg:block lg:max-w-sm">
    <figure class="photo-glow">
      <img src="/images/griffin.jpg" alt="Griffin Haag smiling in a beanie and glasses in front of a rock wall" width="869" height="1100" loading="lazy" class="aspect-[4/5] w-full rounded-2xl object-cover object-top" />
    </figure>
    <div class="panel panel-sm mt-6 sm:mt-0 lg:mt-6">
      <p class="meta text-sm">Lately</p>
      <ul class="mt-3 space-y-2 text-muted">
        <li>Developing .NET services with <span class="whitespace-nowrap">spec-driven</span> development at KorTerra</li>
        <li>Taking computer science classes at the U&nbsp;of&nbsp;M</li>
        <li>Working on the next game for <a class="link" href={links.games} target="_blank" rel="noopener">GriffinGames</a></li>
      </ul>
    </div>
  </div>

  <div>
      <div class="max-w-[62ch] space-y-5 text-lg text-muted">
        <p>
          <span class="text-text">I’ve always loved building websites.</span> I wrote my first code at an iD Tech camp when I was nine, ran my Boy Scout
          troop’s website while in high school, and went back to iD Tech in 2024 to teach Python.
        </p>
        <p>
          Currently I build backend systems at KorTerra and study computer science at the University of Minnesota. I do work for clients such as
          creating websites, and I enjoy developing games to play with my friends.
        </p>
      </div>

      <ul class="mt-8 flex flex-wrap gap-2">
        {facts.map((f) => <li class="rounded-full border border-line px-3.5 py-1.5 text-[0.95rem]">{f}</li>)}
      </ul>

      <h3 class="mt-14 font-display text-2xl font-medium">Off the clock</h3>
      <ul class="hobbies mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <li>
          <button type="button" class="hobby" data-hobby="sports" aria-label="Sports. Hover or tap to play a touchdown pass.">
            <svg class="ic ic-tv" viewBox="0 0 40 40" aria-hidden="true">
              <path d="M16 5.5l4 3.5 4-3.5" />
              <rect x="4.5" y="9" width="31" height="22" rx="3" />
              <path d="M15 34.5h10M20 31v3.5" />
              <rect class="tv-endzone" x="28.6" y="12" width="4" height="16" rx="0.6" />
              <path class="tv-lines" d="M12.5 12.5v15M18 12.5v15M23.5 12.5v15" />
              <g class="tv-qb"><circle cx="11" cy="17.4" r="1.1" /><path d="M11 18.6v3.6M11 22.2l-1.5 2.4M11 22.2l1.5 2.4M11 19.4l-1.6 1.2" /><path class="tv-arm" d="M11 19.4l1.6 1.2" /></g>
              <g class="tv-wr"><circle cx="20" cy="17.4" r="1.1" /><path d="M20 18.6v3.6M20 22.2l-1.5 2.4M20 22.2l1.5 2.4" /><path class="wr-down" d="M20 19.4l1.6 1.2M20 19.4l-1.6 1.2" /><path class="wr-up" d="M20 19.4l1.3-1.9M20 19.4l-1.3-1.9" /></g>
              <ellipse class="tv-ball" cx="12.9" cy="20.9" rx="1.3" ry="0.75" />
              <g class="tv-confetti">
                <rect x="30.1" y="16.6" width="1.2" height="0.6" style="--dx: -3.0px; --dy: -4.2px; --r: 150deg" />
                <rect x="30.1" y="16.6" width="1.2" height="0.6" style="--dx: -1.6px; --dy: -5.4px; --r: -120deg" />
                <rect x="30.1" y="16.6" width="1.2" height="0.6" style="--dx: -0.2px; --dy: -6px; --r: 200deg" />
                <rect x="30.1" y="16.6" width="1.2" height="0.6" style="--dx: 1.2px; --dy: -5.2px; --r: -160deg" />
                <rect x="30.1" y="16.6" width="1.2" height="0.6" style="--dx: 2.4px; --dy: -3.6px; --r: 110deg" />
                <rect x="30.1" y="16.6" width="1.2" height="0.6" style="--dx: -2.4px; --dy: -2.4px; --r: 90deg" />
                <rect x="30.1" y="16.6" width="1.2" height="0.6" style="--dx: 0.8px; --dy: -3px; --r: -200deg" />
              </g>
            </svg>
            <span>Sports</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="ski">
            <svg class="ic ic-ski" viewBox="0 0 40 40" aria-hidden="true">
              <path d="M3 32 18 10l8 11 4-4 7 15Z" />
              <path class="ski-trail" d="M17.6 12.6C15 14 14 15.2 14.4 16.6S17.8 19 17 20.6S12.2 23 12.2 24.6S15.6 27 15 28.6S10.6 30.4 9.6 31" pathLength="1" />
              <g transform="translate(17.6 12.6)"><g class="ski-run">
                <path class="skier" d="M-3.2.6h6.4M-.4 0 .9-2.4-.3-3.9 1.1-6M.6-5 2.4-3.4" />
                <circle class="skier-head" cx="1.8" cy="-7.1" r="1.15" />
              </g></g>
            </svg>
            <span>Skiing</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="cook">
            <svg class="ic ic-pan" viewBox="0 0 40 40" aria-hidden="true">
              <path class="steam" d="M13 15c-1.5-2 1.5-3 0-5M19 15c-1.5-2 1.5-3 0-5M25 15c-1.5-2 1.5-3 0-5" />
              <g class="steak"><path d="M13.6 19.4c-.4-1.6 1-2.8 3-2.9l3.4-.2c2.3-.1 4 .8 4 2.2 0 1.3-1.2 2-3 2.1l-4.6.2c-1.4.1-2.5-.4-2.8-1.4Z" /><path d="M16.2 18.6c1.2-.6 3-.7 4.6-.3" /></g>
              <path d="M6 21h22a0 0 0 0 1 0 0 8 8 0 0 1-8 8h-6a8 8 0 0 1-8-8Z" /><path d="M28 21h7" />
            </svg>
            <span>Cooking</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="board" aria-label="Board games. Hover or tap to play a move.">
            <svg class="ic ic-board" viewBox="0 0 40 40" aria-hidden="true">
              <rect x="5" y="27" width="30" height="4" rx="1" />
              <path class="bg-spaces" d="M11 27v4M17 27v4M23 27v4M29 27v4" />
              <g transform="translate(26 27)"><g class="bg-foe"><path d="M-3 0h6c0-1.2-.6-1.8-1.6-2.2-.4-.9-.5-1.7-.4-2.4h-2c.1.7 0 1.5-.4 2.4-1 .4-1.6 1-1.6 2.2Z" /><circle cx="0" cy="-6.5" r="1.7" /></g></g>
              <g transform="translate(8 27)"><g class="bg-hero"><path d="M-3 0h6c0-1.2-.6-1.8-1.6-2.2-.4-.9-.5-1.7-.4-2.4h-2c.1.7 0 1.5-.4 2.4-1 .4-1.6 1-1.6 2.2Z" /><circle cx="0" cy="-6.5" r="1.7" /></g></g>
            </svg>
            <span>Board games</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="games">
            <svg class="ic ic-pad" viewBox="0 0 40 40" aria-hidden="true"><path d="M12 13h16a7 7 0 0 1 6.8 8.6l-1.3 5.5a3.3 3.3 0 0 1-5.7 1.4L24.5 25h-9l-3.3 3.5a3.3 3.3 0 0 1-5.7-1.4l-1.3-5.5A7 7 0 0 1 12 13Z" /><path d="M13 17v5M10.5 19.5h5" /><circle class="btn-a" cx="26" cy="18" r="1.3" /><circle class="btn-b" cx="28.5" cy="21" r="1.3" /></svg>
            <span>CS2 & Rocket League</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="es" aria-label="Hablo español. Hover for two seconds to say hola.">
            <svg class="ic ic-chat" viewBox="0 0 40 40" aria-hidden="true">
              <path class="bubble" d="M7 11h18a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H15l-5 4v-4H7a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3Z" />
              <path class="pop-burst" d="M2 8.5.6 7.1M16 6.6V4.6M30 8.5l1.4-1.4M31.6 18h2" />
              <g class="dots2"><circle class="d d1" cx="11" cy="18" r="1.15" /><circle class="d d2" cx="16" cy="18" r="1.15" /><circle class="d d3" cx="21" cy="18" r="1.15" /></g>
              <text class="hola" x="16" y="20.2" text-anchor="middle">Hola</text>
            </svg>
            <span data-es>Hablo español</span>
          </button>
        </li>
      </ul>
  </div>
</Section>

<style>
  .photo-glow { position: relative; isolation: isolate; }
  .photo-glow::before {
    content: '';
    position: absolute;
    inset: -12% -14% -6% -10%;
    z-index: -1;
    background:
      radial-gradient(45% 40% at 72% 30%, rgba(214, 120, 64, 0.22), transparent 70%),
      radial-gradient(55% 50% at 25% 70%, rgba(122, 31, 46, 0.28), transparent 72%);
    filter: blur(8px);
  }
  .photo-glow img { box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(159, 178, 207, 0.18); }

  .hobby {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem 1.1rem;
    border-radius: 0.9rem;
    border: 1px solid var(--color-line);
    text-align: left;
    font-size: 0.95rem;
    cursor: pointer;
    transition: border-color 200ms, background-color 200ms;
    -webkit-tap-highlight-color: transparent;
  }
  .ic {
    width: 2.5rem;
    height: 2.5rem;
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
    transition: stroke 200ms;
  }
  .ic .skier, .ic .btn-a, .ic .btn-b, .ic .ski-trail, .ic .steak { stroke: var(--color-wine); }
  .ic .skier { stroke-width: 1.25; }
  .ic .skier-head { fill: var(--color-wine); stroke: none; }
  .ic-ski .ski-trail { stroke-width: 0.8; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0.85; fill: none; }
  .ic-pan .steak { stroke-width: 1.3; opacity: 0; }
  .ic-tv .wr-up { opacity: 0; }
  .ic-board .bg-spaces { stroke-width: 0.8; stroke-opacity: 0.6; }
  .ic-board .bg-hero path, .ic-board .bg-hero circle { fill: var(--color-wine); stroke: none; }
  .ic-board .bg-foe path, .ic-board .bg-foe circle { fill: none; stroke-width: 1.1; }
  .ic-chat .hola { font: 600 6.4px var(--font-display, sans-serif); fill: var(--color-text); stroke: none; opacity: 0; }
  .ic-chat .d { fill: var(--color-muted); stroke: none; transition: fill 200ms; }
  .ic-chat .pop-burst { stroke: var(--color-wine); stroke-width: 1.1; opacity: 0; }
  .hobby.hola .ic-chat .hola { opacity: 1; }
  .hobby.hola .ic-chat .dots2 { opacity: 0; }
  .ic-tv .tv-confetti rect { fill: var(--color-wine); stroke: none; opacity: 0; }
  .ic-tv .tv-lines { stroke-width: 0.6; stroke-opacity: 0.45; }
  .ic-tv .tv-endzone { fill: transparent; stroke-width: 0.6; stroke-opacity: 0.6; }
  .ic-tv .tv-qb, .ic-tv .tv-wr { stroke-width: 1.1; }
  .ic-tv .tv-ball { fill: var(--color-muted); stroke: none; transition: fill 200ms; }
  .hobby:hover .ic-tv .tv-ball, .hobby.active .ic-tv .tv-ball { fill: var(--color-text); }

  .hobby:hover, .hobby:focus-visible, .hobby.active { border-color: var(--color-muted); background: var(--color-slate); }
  .hobby:hover .ic, .hobby:focus-visible .ic, .hobby.active .ic { stroke: var(--color-text); }

  @media (prefers-reduced-motion: no-preference) {
    /* Sports: a passing touchdown on the TV. The QB drops back, the receiver runs into the end zone and makes
       the catch, celebrates, spikes the ball, and the play resets. */
    .ic-tv .tv-wr, .ic-tv .tv-qb, .ic-tv .tv-arm { transform-box: view-box; }
    /* The ball spins around its own center while it travels. */
    .ic-tv .tv-ball { transform-box: fill-box; transform-origin: center; }
    .ic-tv .tv-arm { transform-origin: 11px 19.4px; }
    .hobby:hover .ic-tv .tv-qb, .hobby.active .ic-tv .tv-qb { animation: tv-qb 3.6s ease-in-out infinite; }
    .hobby:hover .ic-tv .tv-arm, .hobby.active .ic-tv .tv-arm { animation: tv-throw 3.6s ease-in-out infinite; }
    .hobby:hover .ic-tv .tv-ball, .hobby.active .ic-tv .tv-ball { animation: tv-ball 3.6s linear infinite; }
    .hobby:hover .ic-tv .tv-wr, .hobby.active .ic-tv .tv-wr { animation: tv-run 3.6s ease-in-out infinite; }
    .hobby:hover .ic-tv .wr-down, .hobby.active .ic-tv .wr-down { animation: tv-arms-down 3.6s steps(1) infinite; }
    .hobby:hover .ic-tv .wr-up, .hobby.active .ic-tv .wr-up { animation: tv-arms-up 3.6s steps(1) infinite; }
    .ic-tv .tv-confetti rect { transform-box: fill-box; transform-origin: center; }
    .hobby:hover .ic-tv .tv-confetti rect, .hobby.active .ic-tv .tv-confetti rect { animation: tv-confetti 3.6s ease-out infinite; }
    /* Skiing: the skier carves S-turns down the face, riding the track as it draws, then resets at the top. */
    .ic-ski .ski-run { transform-box: view-box; transform-origin: 0 0; }
    .hobby:hover .ic-ski .ski-run, .hobby.active .ic-ski .ski-run { animation: ski-run 3.4s linear infinite; }
    .hobby:hover .ic-ski .ski-trail, .hobby.active .ic-ski .ski-trail { animation: ski-trail 3.4s linear infinite; }
    /* Cooking: a steak appears in the pan, flips up and over, lands, then fades out. */
    .ic-pan .steak { transform-box: fill-box; transform-origin: center; }
    .hobby:hover .ic-pan .steak, .hobby.active .ic-pan .steak { animation: steak-flip 2s ease-in-out infinite; }
    .hobby:hover .ic-pan .steam, .hobby.active .ic-pan .steam { animation: steam 1.1s ease-in-out infinite; }
    .hobby:hover .ic-pad .btn-a, .hobby.active .ic-pad .btn-a { animation: blink 500ms steps(1) infinite; }
    .hobby:hover .ic-pad .btn-b, .hobby.active .ic-pad .btn-b { animation: blink 500ms steps(1) 250ms infinite; }
    /* Hablo español: the dots light up one by one over two seconds, then the bubble pops and "Hola" springs in. */
    .ic-chat .d, .ic-chat .bubble, .ic-chat .hola, .ic-chat .pop-burst { transform-box: fill-box; transform-origin: center; }
    .hobby:hover:not(.hola) .ic-chat .d1, .hobby.active:not(.hola) .ic-chat .d1 { animation: dot-on 350ms ease-out 150ms both; }
    .hobby:hover:not(.hola) .ic-chat .d2, .hobby.active:not(.hola) .ic-chat .d2 { animation: dot-on 350ms ease-out 750ms both; }
    .hobby:hover:not(.hola) .ic-chat .d3, .hobby.active:not(.hola) .ic-chat .d3 { animation: dot-on 350ms ease-out 1350ms both; }
    .hobby.hola .ic-chat .dots2 { animation: dots-pop 260ms ease-out both; }
    .hobby.hola .ic-chat .bubble { animation: bubble-pop 520ms cubic-bezier(0.34, 1.56, 0.64, 1) both; }
    .hobby.hola .ic-chat .pop-burst { animation: pop-burst 520ms ease-out both; }
    .hobby.hola .ic-chat .hola { animation: hola-in 520ms cubic-bezier(0.34, 1.56, 0.64, 1) 90ms both; }
    /* Board games: the maroon pawn hops space by space, lands on the other pawn's space, and knocks it off
       the board. */
    .ic-board .bg-hero { transform-box: fill-box; transform-origin: 50% 100%; }
    .ic-board .bg-foe { transform-box: fill-box; transform-origin: 50% 60%; }
    .hobby:hover .ic-board .bg-hero, .hobby.active .ic-board .bg-hero { animation: bg-hero 3s ease-in-out infinite; }
    .hobby:hover .ic-board .bg-foe, .hobby.active .ic-board .bg-foe { animation: bg-foe 3s ease-in-out infinite; }
  }
  @keyframes tv-qb {
    0%, 8% { transform: translateX(0); }
    22%, 86% { transform: translateX(-2.2px); }
    100% { transform: translateX(0); }
  }
  @keyframes tv-throw {
    0%, 24% { transform: rotate(0deg); }
    32% { transform: rotate(-150deg); }
    37% { transform: rotate(-60deg); }
    44%, 100% { transform: rotate(0deg); }
  }
  @keyframes tv-ball {
    0%, 8% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
    22%, 24% { transform: translate(-2.2px, 0) rotate(0deg); }
    32% { transform: translate(-4.9px, -3.3px) rotate(-30deg); }
    36% { transform: translate(-2.26px, -2.29px) rotate(-16deg); }
    39% { transform: translate(1.07px, -4.96px) rotate(-10deg); }
    42% { transform: translate(4.39px, -6.55px) rotate(-5deg); }
    45% { transform: translate(7.72px, -7.04px) rotate(1deg); }
    48% { transform: translate(11.05px, -6.45px) rotate(7deg); }
    51% { transform: translate(14.37px, -4.77px) rotate(12deg); }
    54% { transform: translate(17.7px, -2px) rotate(18deg); }
    58% { transform: translate(17.7px, -3.6px) rotate(18deg); }
    61% { transform: translate(17.7px, -2px) rotate(18deg); }
    64% { transform: translate(17.7px, -3.6px) rotate(18deg); }
    67% { transform: translate(17.7px, -2px) rotate(18deg); }
    71% { transform: translate(18.2px, -4.9px) rotate(-30deg); }
    75% { transform: translate(18.6px, 2.9px) rotate(60deg); }
    78% { transform: translate(19.4px, 1.3px) rotate(110deg); }
    81%, 84% { transform: translate(20px, 2.9px) rotate(160deg); opacity: 1; }
    88% { transform: translate(20px, 2.9px) rotate(160deg); opacity: 0; }
    90% { transform: translate(0, 0) rotate(0deg); opacity: 0; }
    100% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
  }
  @keyframes tv-run {
    0%, 8% { transform: translate(0, 0); opacity: 1; }
    45%, 54% { transform: translate(10px, 0); }
    58% { transform: translate(10px, -1.6px); }
    61% { transform: translate(10px, 0); }
    64% { transform: translate(10px, -1.6px); }
    67%, 84% { transform: translate(10px, 0); opacity: 1; }
    88% { transform: translate(10px, 0); opacity: 0; }
    90% { transform: translate(0, 0); opacity: 0; }
    100% { transform: translate(0, 0); opacity: 1; }
  }
  @keyframes tv-arms-down { 0% { opacity: 1; } 51% { opacity: 0; } 70% { opacity: 1; } }
  @keyframes tv-arms-up { 0% { opacity: 0; } 51% { opacity: 1; } 70% { opacity: 0; } }
  @keyframes tv-confetti {
    0%, 55% { transform: translate(0, 0) rotate(0deg); opacity: 0; }
    57% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
    64% { transform: translate(var(--dx), var(--dy)) rotate(var(--r)); opacity: 1; }
    74% { transform: translate(var(--dx), calc(var(--dy) + 3px)) rotate(calc(var(--r) * 2)); opacity: 0; }
    100% { transform: translate(var(--dx), calc(var(--dy) + 3px)) rotate(calc(var(--r) * 2)); opacity: 0; }
  }
  @keyframes ski-run {
    0%, 8% { transform: translate(0, 0) scaleX(-1) rotate(10deg); opacity: 1; }
    10.1% { transform: translate(-0.90px, 0.52px) scaleX(-1) rotate(17deg); opacity: 1; }
    11.9% { transform: translate(-1.65px, 1.02px) scaleX(-1) rotate(20deg); opacity: 1; }
    13.4% { transform: translate(-2.26px, 1.51px) scaleX(-1) rotate(23deg); opacity: 1; }
    14.7% { transform: translate(-2.73px, 2.00px) scaleX(-1) rotate(28deg); opacity: 1; }
    15.9% { transform: translate(-3.05px, 2.49px) scaleX(-1) rotate(34deg); opacity: 1; }
    17.0% { transform: translate(-3.23px, 2.98px) scaleX(-1) rotate(35deg); opacity: 1; }
    18.0% { transform: translate(-3.28px, 3.48px) scaleX(1) rotate(35deg); opacity: 1; }
    19.0% { transform: translate(-3.20px, 4.00px) scaleX(1) rotate(35deg); opacity: 1; }
    20.1% { transform: translate(-2.94px, 4.51px) scaleX(1) rotate(30deg); opacity: 1; }
    21.4% { transform: translate(-2.51px, 4.99px) scaleX(1) rotate(25deg); opacity: 1; }
    22.8% { transform: translate(-1.99px, 5.46px) scaleX(1) rotate(23deg); opacity: 1; }
    24.2% { transform: translate(-1.45px, 5.92px) scaleX(1) rotate(23deg); opacity: 1; }
    25.6% { transform: translate(-0.97px, 6.40px) scaleX(1) rotate(27deg); opacity: 1; }
    26.8% { transform: translate(-0.61px, 6.90px) scaleX(1) rotate(35deg); opacity: 1; }
    27.9% { transform: translate(-0.47px, 7.43px) scaleX(1) rotate(35deg); opacity: 1; }
    29.0% { transform: translate(-0.60px, 8.00px) scaleX(-1) rotate(35deg); opacity: 1; }
    30.4% { transform: translate(-1.04px, 8.57px) scaleX(-1) rotate(25deg); opacity: 1; }
    32.1% { transform: translate(-1.69px, 9.07px) scaleX(-1) rotate(19deg); opacity: 1; }
    33.9% { transform: translate(-2.47px, 9.55px) scaleX(-1) rotate(16deg); opacity: 1; }
    35.8% { transform: translate(-3.30px, 10.00px) scaleX(-1) rotate(16deg); opacity: 1; }
    37.6% { transform: translate(-4.09px, 10.45px) scaleX(-1) rotate(18deg); opacity: 1; }
    39.2% { transform: translate(-4.76px, 10.92px) scaleX(-1) rotate(22deg); opacity: 1; }
    40.6% { transform: translate(-5.23px, 11.43px) scaleX(-1) rotate(33deg); opacity: 1; }
    41.8% { transform: translate(-5.40px, 12.00px) scaleX(-1) rotate(35deg); opacity: 1; }
