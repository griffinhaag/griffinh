---
import Section from './Section.astro';
import { facts, links } from '../data/site';
---

<Section id="about" title="About me" band>
  <div slot="aside" class="mt-10 max-w-sm sm:grid sm:max-w-none sm:grid-cols-[minmax(0,17rem)_minmax(0,1fr)] sm:items-end sm:gap-6 lg:block lg:max-w-sm">
    <figure class="photo-glow">
      <img src="/images/griffin.jpg" alt="Griffin Haag smiling in a beanie and glasses in front of a rock wall" width="869" height="1100" loading="lazy" class="aspect-[4/5] w-full rounded-2xl object-cover object-top" />
    </figure>
    <div class="panel panel-sm mt-6 sm:mt-0 lg:mt-6">
      <p class="meta text-sm">Lately</p>
      <ul class="mt-3 space-y-2 text-muted">
        <li>Building .NET services and Terraform modules at KorTerra</li>
        <li>Taking computer science classes at the U&nbsp;of&nbsp;M</li>
        <li>Working on the next game for <a class="link" href={links.games} target="_blank" rel="noopener">GriffinGames</a></li>
      </ul>
    </div>
  </div>

  <div>
      <div class="max-w-[62ch] space-y-5 text-lg text-muted">
        <p>
          <span class="text-text">I’ve always loved building websites.</span> I wrote my first code at an iD Tech camp when I was nine, ran my Boy Scout
          troop’s website as a kid, and went back to iD Tech in 2024 to teach Python.
        </p>
        <p>
          These days I build backend systems at KorTerra and study computer science at the University of Minnesota. On my own time I make things for
          people I know, like client sites and the game night platform my friends and I play.
        </p>
      </div>

      <ul class="mt-8 flex flex-wrap gap-2">
        {facts.map((f) => <li class="rounded-full border border-line px-3.5 py-1.5 text-[0.95rem]">{f}</li>)}
      </ul>

      <h3 class="mt-14 font-display text-2xl font-medium">Off the clock</h3>
      <ul class="hobbies mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <li>
          <button type="button" class="hobby" data-hobby="basketball">
            <svg class="ic ic-ball" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="13" /><path d="M20 7v26M7 20h26" /><path d="M11.2 10.4c3.9 5.3 3.9 13.9 0 19.2M28.8 10.4c-3.9 5.3-3.9 13.9 0 19.2" /></svg>
            <span>Basketball</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="ski">
            <svg class="ic ic-ski" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 32 17 12l6 8 4-5 9 17Z" /><path class="skier" d="M12 27c3-1 7-1.5 10-1" /><circle class="skier" cx="23.5" cy="23" r="1.6" /></svg>
            <span>Skiing</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="cook">
            <svg class="ic ic-pan" viewBox="0 0 40 40" aria-hidden="true"><path d="M6 21h22a0 0 0 0 1 0 0 8 8 0 0 1-8 8h-6a8 8 0 0 1-8-8Z" /><path d="M28 21h7" /><path class="steam" d="M13 15c-1.5-2 1.5-3 0-5M19 15c-1.5-2 1.5-3 0-5M25 15c-1.5-2 1.5-3 0-5" /></svg>
            <span>Cooking</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="dice" aria-label="Board games. Click to roll the die.">
            <svg class="ic ic-die" viewBox="0 0 40 40" aria-hidden="true"><rect x="9" y="9" width="22" height="22" rx="5" /><g class="pips" data-pips></g></svg>
            <span>Board games</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="games">
            <svg class="ic ic-pad" viewBox="0 0 40 40" aria-hidden="true"><path d="M12 13h16a7 7 0 0 1 6.8 8.6l-1.3 5.5a3.3 3.3 0 0 1-5.7 1.4L24.5 25h-9l-3.3 3.5a3.3 3.3 0 0 1-5.7-1.4l-1.3-5.5A7 7 0 0 1 12 13Z" /><path d="M13 17v5M10.5 19.5h5" /><circle class="btn-a" cx="26" cy="18" r="1.3" /><circle class="btn-b" cx="28.5" cy="21" r="1.3" /></svg>
            <span>CS2 & Rocket League</span>
          </button>
        </li>
        <li>
          <button type="button" class="hobby" data-hobby="es">
            <svg class="ic ic-chat" viewBox="0 0 40 40" aria-hidden="true"><path d="M7 11h18a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H15l-5 4v-4H7a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3Z" /><path class="dots2" d="M11 18h.01M16 18h.01M21 18h.01" /></svg>
            <span data-es>Hablo español</span>
          </button>
        </li>
      </ul>
  </div>
</Section>

<style>
  .photo-glow { position: relative; isolation: isolate; }
  .photo-glow::before {
    content: '';
    position: absolute;
    inset: -12% -14% -6% -10%;
    z-index: -1;
    background:
      radial-gradient(45% 40% at 72% 30%, rgba(214, 120, 64, 0.22), transparent 70%),
      radial-gradient(55% 50% at 25% 70%, rgba(122, 31, 46, 0.28), transparent 72%);
    filter: blur(8px);
  }
  .photo-glow img { box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(159, 178, 207, 0.18); }

  .hobby {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem 1.1rem;
    border-radius: 0.9rem;
    border: 1px solid var(--color-line);
    text-align: left;
    font-size: 0.95rem;
    cursor: pointer;
    transition: border-color 200ms, background-color 200ms;
    -webkit-tap-highlight-color: transparent;
  }
  .ic {
    width: 2.5rem;
    height: 2.5rem;
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
    transition: stroke 200ms;
  }
  .ic .skier, .ic .btn-a, .ic .btn-b { stroke: var(--color-wine); }
  .ic .pips circle { fill: var(--color-muted); stroke: none; transition: fill 200ms; }

  .hobby:hover, .hobby:focus-visible, .hobby.active { border-color: var(--color-muted); background: var(--color-slate); }
  .hobby:hover .ic, .hobby:focus-visible .ic, .hobby.active .ic { stroke: var(--color-text); }
  .hobby:hover .pips circle, .hobby.active .pips circle { fill: var(--color-wine); }

  @media (prefers-reduced-motion: no-preference) {
    .hobby:hover .ic-ball, .hobby.active .ic-ball { animation: bounce 600ms cubic-bezier(0.3, 0, 0.5, 1) infinite alternate; }
    .hobby:hover .ic-ski .skier, .hobby.active .ic-ski .skier { animation: carve 1.2s ease-in-out infinite; }
    .hobby:hover .ic-pan .steam, .hobby.active .ic-pan .steam { animation: steam 1.1s ease-in-out infinite; }
    .hobby:hover .ic-pad .btn-a, .hobby.active .ic-pad .btn-a { animation: blink 500ms steps(1) infinite; }
    .hobby:hover .ic-pad .btn-b, .hobby.active .ic-pad .btn-b { animation: blink 500ms steps(1) 250ms infinite; }
    .hobby:hover .ic-chat .dots2, .hobby.active .ic-chat .dots2 { animation: blink 900ms steps(1) infinite; }
    .ic-die.roll { animation: roll 500ms var(--ease-out-quint); transform-origin: center; transform-box: fill-box; }
  }
  @keyframes bounce { to { transform: translateY(-6px); } }
  @keyframes carve { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-6px, 3px); } }
  @keyframes steam { 0% { opacity: 0.2; transform: translateY(2px); } 50% { opacity: 1; } 100% { opacity: 0.2; transform: translateY(-3px); } }
  @keyframes blink { 50% { opacity: 0.15; } }
  @keyframes roll { from { transform: rotate(-200deg) scale(0.8); } }
</style>

<script>
  const PIPS: Record<number, [number, number][]> = {
    1: [[20, 20]],
    2: [[15, 15], [25, 25]],
    3: [[15, 15], [20, 20], [25, 25]],
    4: [[15, 15], [25, 15], [15, 25], [25, 25]],
    5: [[15, 15], [25, 15], [20, 20], [15, 25], [25, 25]],
    6: [[15, 14], [25, 14], [15, 20], [25, 20], [15, 26], [25, 26]],
  };
  const g = document.querySelector<SVGGElement>('[data-pips]');
  const die = g?.closest('svg');
  const setFace = (n: number) => {
    if (!g) return;
    g.innerHTML = PIPS[n].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="1.9"></circle>`).join('');
  };
  setFace(5);
  document.querySelector('[data-hobby="dice"]')?.addEventListener('click', () => {
    setFace(1 + Math.floor(Math.random() * 6));
    die?.classList.remove('roll');
    void die?.getBoundingClientRect();
    die?.classList.add('roll');
  });

  // The Spanish tile answers back.
  const es = document.querySelector<HTMLElement>('[data-es]');
  const lines = ['Hablo español', '¡Hola! ¿Qué tal?', 'Sí, de verdad', 'Hablo español'];
  let i = 0;
  document.querySelector('[data-hobby="es"]')?.addEventListener('click', () => {
    i = (i + 1) % lines.length;
    if (es) es.textContent = lines[i];
  });

  // On touch screens, tapping a tile plays its animation.
  document.querySelectorAll<HTMLElement>('.hobby').forEach((b) => {
    b.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      document.querySelectorAll('.hobby.active').forEach((x) => x !== b && x.classList.remove('active'));
      b.classList.toggle('active');
    });
  });
</script>
