<script>
  // Clicking the Spanish tile cycles through its Spanish phrases.
  const es = document.querySelector<HTMLElement>('[data-es]');
  const lines = ['Hablo español', '¡Hola! ¿Qué tal?', 'Sí, de verdad', 'Hablo español'];
  let i = 0;
  const esBtn = document.querySelector<HTMLElement>('[data-hobby="es"]');
  esBtn?.addEventListener('click', () => {
    i = (i + 1) % lines.length;
    if (es) es.textContent = lines[i];
  });
  // After two seconds of hover (or of being tapped active), the bubble says "Hola".
  let holaTimer = 0;
  const holaOn = () => {
    clearTimeout(holaTimer);
    holaTimer = window.setTimeout(() => esBtn?.classList.add('hola'), 2000);
  };
  const holaOff = () => {
    clearTimeout(holaTimer);
    esBtn?.classList.remove('hola');
  };
  esBtn?.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && holaOn());
  esBtn?.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && holaOff());
  if (esBtn) {
    let wasActive = false;
    new MutationObserver(() => {
      const active = esBtn.classList.contains('active');
      if (active !== wasActive) (wasActive = active) ? holaOn() : holaOff();
    }).observe(esBtn, { attributes: true, attributeFilter: ['class'] });
  }

  // On touch screens, tapping a tile plays its animation.
  document.querySelectorAll<HTMLElement>('.hobby').forEach((b) => {
    b.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      document.querySelectorAll('.hobby.active').forEach((x) => x !== b && x.classList.remove('active'));
      b.classList.toggle('active');
    });
  });
</script>
