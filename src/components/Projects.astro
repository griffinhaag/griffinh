---
import Section from './Section.astro';
import GamesPreview from './GamesPreview.astro';
import DayOneDemo from './DayOneDemo.astro';
import { builds, clients, links } from '../data/site';
---

<Section id="projects" title="Things I’ve built" sticky={false} band>
  <p class="max-w-[38rem] text-lg text-muted lg:pt-3 lg:text-xl">
    <span class="text-text">The two I’m proudest of come first, and both are playable right on this page.</span> After those are smaller
    projects from school and teaching, and the websites I’ve built for clients.
  </p>

  <Fragment slot="after">
    <!-- Featured projects: one card each, the story on the left and the working preview on the right. -->
    <article class="feature panel mt-14" data-peek>
      <span class="peek" aria-hidden="true">
        <span class="peek-back"><svg viewBox="0 0 56 30" width="56" height="30">
          <circle cx="28" cy="27" r="8.5" fill="#dfe5f1" />
          <path d="M19.2 27a8.8 8.8 0 0 1 17.6 0" fill="none" stroke="#962a3d" stroke-width="1.8" />
          <rect x="17.4" y="23.4" width="3.4" height="6.6" rx="1.5" fill="#962a3d" />
          <rect x="35.2" y="23.4" width="3.4" height="6.6" rx="1.5" fill="#962a3d" />
          <g class="peek-eyes" fill="#151a29"><circle cx="25" cy="25" r="1" /><circle cx="31" cy="25" r="1" /></g>
        </svg></span>
        <span class="peek-front"><svg viewBox="0 0 56 34" width="56" height="34"><g fill="#dfe5f1"><rect x="14" y="26" width="7.5" height="6" rx="2.6" /><rect x="34.5" y="26" width="7.5" height="6" rx="2.6" /></g></svg></span>
      </span>
      <div class="feature-grid">
        <div>
          <p class="meta text-sm">Side project, 2025 – present</p>
          <h3 class="mt-2 font-display text-4xl font-semibold tracking-tight">GriffinGames</h3>
          <p class="mt-4 text-lg">
            Party games I made for game nights with my friends. One person puts it on the TV, and everyone else joins from their phone with a room code.
          </p>
          <ul class="mt-6 space-y-3 text-muted">
            <li class="fact">LOCKED IN is a buzzer trivia game with about 6,500 questions across 11 categories.</li>
            <li class="fact">A Node and Socket.IO server keeps every screen in sync, decides who buzzed first, and lets people rejoin when their phone drops off Wi‑Fi.</li>
            <li class="fact">Typed answers are graded by an LLM, so a typo or a last name alone still counts.</li>
          </ul>
          <div class="feature-foot">
            <p class="flex flex-wrap gap-2">
              {['JavaScript', 'Node.js', 'Socket.IO', 'Express', 'Groq', 'Render', 'Netlify'].map((t) => <span class="tag">{t}</span>)}
            </p>
            <div class="flex flex-wrap gap-3">
              <a href={links.games} class="btn btn-primary" target="_blank" rel="noopener">Play my live game</a>
              <a href="/projects/griffingames" class="btn btn-ghost" target="_blank" rel="noopener">How I built it</a>
            </div>
          </div>
        </div>
        <div>
          <GamesPreview />
        </div>
      </div>
    </article>

    <article class="feature panel mt-8" data-peek>
      <span class="peek" aria-hidden="true">
        <span class="peek-back"><svg viewBox="0 0 56 30" width="56" height="30">
          <circle cx="28" cy="27" r="8.5" fill="#dfe5f1" />
          <path d="M17.5 19.6 28 15.4l10.5 4.2L28 23.8Z" fill="#151a29" />
          <path d="M36.4 19.8v5.4" stroke="#f0b03a" stroke-width="1" stroke-linecap="round" />
          <circle cx="36.4" cy="25.8" r="1" fill="#f0b03a" />
          <g class="peek-eyes" fill="#151a29"><circle cx="25" cy="26" r="1" /><circle cx="31" cy="26" r="1" /></g>
        </svg></span>
        <span class="peek-front"><svg viewBox="0 0 56 34" width="56" height="34"><g fill="#dfe5f1"><rect x="14" y="26" width="7.5" height="6" rx="2.6" /><rect x="34.5" y="26" width="7.5" height="6" rx="2.6" /></g></svg></span>
      </span>
      <div class="feature-grid">
        <div>
          <p class="meta text-sm">Dunwoody capstone, 2025</p>
          <h3 class="mt-2 font-display text-4xl font-semibold tracking-tight">DayONE</h3>
          <p class="mt-4 text-lg">
            A help site for new Dunwoody students. It collects short videos that walk you through common setup problems, sorted by platform and topic.
          </p>
          <ul class="mt-6 space-y-3 text-muted">
            <li class="fact">I wrote the application, and my teammate Lucas Kells deployed it on AWS S3.</li>
            <li class="fact">Video titles come from the YouTube Data API. You can filter by platform and topic, or search.</li>
            <li class="fact">Students can register and log in, and admins get a dashboard for managing videos and categories.</li>
          </ul>
          <p class="meta mt-6 text-sm">Go ahead and use it. Log in to try the admin tools.</p>
          <div class="feature-foot">
            <p class="flex flex-wrap gap-2">
              {['JavaScript', 'Bootstrap', 'YouTube Data API', 'AWS S3'].map((t) => <span class="tag">{t}</span>)}
            </p>
            <div class="flex flex-wrap gap-3">
              <a href="/projects/dayone" class="btn btn-primary" target="_blank" rel="noopener">How I built it</a>
              <a href="https://github.com/griffinhaag/dayone" class="btn btn-ghost" target="_blank" rel="noopener">View the code</a>
            </div>
          </div>
        </div>
        <div>
          <DayOneDemo />
        </div>
      </div>
    </article>

    <!-- Everything else: short cards, with the rest a click away instead of a wall of text. -->
    <div class="row plain mt-24">
      <div>
        <h3 class="font-display text-3xl font-semibold tracking-tight">More projects</h3>
        <p class="mt-4 max-w-sm text-muted">Smaller things I’ve built, mostly for classes and while teaching.</p>
        <a href={links.github} class="btn btn-ghost mt-6" target="_blank" rel="noopener">All my code on GitHub</a>
      </div>
      <div>
        <ul class="grid gap-3 sm:grid-cols-2" data-builds>
          {builds.map((b, i) => (
            <li class={`build-card ${i >= 4 ? 'extra' : ''}`} hidden={i >= 4}>
              <p class="font-display text-lg font-medium tracking-tight">{b.name}</p>
              <p class="mt-1 text-[0.95rem] leading-snug text-muted">{b.blurb}</p>
              <div class="mt-auto flex items-end justify-between gap-3 pt-4">
                <p class="text-xs text-muted">{b.stack.join(', ')}</p>
                {b.href && (
                  <a href={b.href} class="code-link" target="_blank" rel="noopener" aria-label={`View the code for ${b.name} on GitHub`}>
                    Code
                    <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 10 10 4M5 4h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
        {builds.length > 4 && (
          <button type="button" class="btn btn-ghost mt-4" data-builds-toggle aria-expanded="false">Show {builds.length - 4} more</button>
        )}
      </div>
    </div>

    <div class="row plain mt-20">
      <div>
        <h3 class="font-display text-3xl font-semibold tracking-tight">Client work</h3>
        <p class="mt-4 max-w-sm text-muted">Sites I’ve designed and built for local businesses since 2023.</p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {clients.map((c) => (
          <li class="rounded-xl border border-line p-5">
            <p class="font-display text-xl font-medium tracking-tight">
              {c.href ? <a href={c.href} class="link !text-text" target="_blank" rel="noopener">{c.name}</a> : c.name}
            </p>
            <p class="mt-1 text-muted">{c.what}</p>
          </li>
        ))}
      </ul>
    </div>
  </Fragment>
</Section>

<style>
  .feature { position: relative; padding: 1.5rem; transition: box-shadow 500ms ease; }
  /* A little character peeks over the top-left edge of whichever project you're looking at. The clip
     box ends a few pixels into the card, so the hands overlap the border and everything else hides below it. */
  /* The head sits in a layer clipped exactly at the card's top border (so it's behind the card); the
     hands sit in a layer that reaches 3px past it, so they grip over the edge. Both are hidden below
     their clip line until the card is active. top is -31px: 30px of drawing plus the 1px border. */
  .peek { position: absolute; left: 2.5rem; top: -31px; width: 56px; height: 34px; pointer-events: none; z-index: 1; }
  .peek-back, .peek-front { position: absolute; left: 0; top: 0; width: 56px; overflow: hidden; }
  .peek-back { height: 30px; }
  .peek-front { height: 34px; }
  .peek svg { display: block; transform: translateY(105%); transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
  .feature.peeking .peek-front svg { transform: translateY(0); }
  .feature.peeking .peek-back svg { transform: translateY(0); transition-delay: 140ms; transition-duration: 560ms; transition-timing-function: cubic-bezier(0.34, 1.35, 0.64, 1); }
  .peek-eyes { transform-box: fill-box; transform-origin: center; }
  .feature.peeking .peek-eyes { animation: peek-blink 3.8s 1.2s infinite; }
  @keyframes peek-blink { 0%, 94%, 100% { transform: scaleY(1); } 97% { transform: scaleY(0.15); } }
  .feature.peeking { box-shadow: 0 0 0 1px rgba(169, 184, 255, 0.22), 0 30px 60px -40px rgba(0, 0, 0, 0.9), 0 0 50px -20px rgba(169, 184, 255, 0.25); }
  @media (prefers-reduced-motion: reduce) {
    .peek svg { transition: opacity 300ms; transform: none; opacity: 0; }
    .feature.peeking .peek svg { opacity: 1; transform: none; }
    .feature.peeking .peek-eyes { animation: none; }
  }
  @media (min-width: 768px) { .feature { padding: 2.25rem; } }
  .feature-grid { display: grid; gap: 2rem; }
  .feature-grid > * { min-width: 0; }
  @media (min-width: 1024px) {
    .feature-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 3rem; align-items: center; }
  }
  .feature-foot {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.25rem;
  }
  .fact { position: relative; padding-left: 1.1rem; }
  .fact::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-mist);
  }
  .build-card {
    display: flex;
    flex-direction: column;
    border-radius: 0.9rem;
    border: 1px solid var(--color-line);
    padding: 1rem 1.1rem;
    background: color-mix(in oklab, var(--color-slate) 55%, transparent);
  }
  .build-card[hidden] { display: none; }
  .code-link {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    padding: 0 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text);
    transition: border-color 200ms, background-color 200ms;
  }
  @media (hover: hover) {
    .code-link:hover { border-color: var(--color-mist); background: color-mix(in oklab, var(--color-mist) 10%, transparent); }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-builds-toggle]');
  if (toggle) {
    const extras = document.querySelectorAll<HTMLElement>('[data-builds] .extra');
    const more = toggle.textContent!.trim();
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      extras.forEach((el) => (el.hidden = !open));
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Show fewer' : more;
      if (open) extras[0]?.querySelector<HTMLElement>('a, p')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  }
</script>

<script>
  // The featured project nearest the middle of the screen gets a peeking visitor, one at a time.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-peek]')];
  let ticking = false;
  const update = () => {
    ticking = false;
    const mid = innerHeight * 0.45;
    let best: HTMLElement | null = null;
    let bestDist = Infinity;
    for (const c of cards) {
      const r = c.getBoundingClientRect();
      // Only a card that actually spans the middle line counts.
      if (r.top > mid || r.bottom < mid) continue;
      const d = Math.abs(r.top + Math.min(r.height, innerHeight) / 2 - mid);
      if (d < bestDist) (best = c), (bestDist = d);
    }
    cards.forEach((c) => c.classList.toggle('peeking', c === best));
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();
</script>
