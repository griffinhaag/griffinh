---
import Section from './Section.astro';
import GamesPreview from './GamesPreview.astro';
import DayOneDemo from './DayOneDemo.astro';
import Peeker from './Peeker.astro';
import { builds, clients, links } from '../data/site';

type Card = { name: string; blurb: string; stack: string[]; href?: string; badge?: string; linkText?: string };
// Client sites are full stack web work, so they sit in that group with a badge.
const clientCards: Card[] = clients.map((c) => ({
  name: c.name,
  blurb: `A website I designed and built for a ${c.what.toLowerCase()}.`,
  stack: ['Client site'],
  href: c.href,
  badge: 'Client',
  linkText: 'Visit',
}));
// Each group leads with its strongest cards (code or a live site); the rest open with "Show more".
const SHOWN = 3;
const byOrder = (items: Card[], order: string[]) =>
  [...items].sort((a, b) => (order.indexOf(a.name) + 1 || 99) - (order.indexOf(b.name) + 1 || 99));
const groups: { id: string; title: string; blurb: string; items: Card[] }[] = [
  {
    id: 'backend',
    title: 'Backend & infrastructure',
    blurb: 'Production services and cloud infrastructure at KorTerra, plus the APIs, pipelines, and data tools I’ve built on my own.',
    items: byOrder(builds.filter((b) => b.kind === 'backend'), ['Software Developer at KorTerra', 'CI/CD pipeline', 'Virtual Pet API', 'Classroom chatbot', 'Data analytics tool', 'Image and webcam recognition']),
  },
  {
    id: 'full-stack',
    title: 'Full stack',
    blurb: 'More apps with a front end, a server, and a database, plus the sites I’ve built for clients since 2023.',
    items: byOrder([...builds.filter((b) => b.kind === 'full'), ...clientCards], ['GadgetHub', 'PHP e-commerce store', 'SendMeAPostcard', 'Budget Tracker', 'SheShuttle', 'Movie generator']),
  },
];
---

<Section id="projects" title="Things I’ve built" sticky={false} band>
  <p class="max-w-[38rem] text-lg text-muted lg:pt-3 lg:text-xl">
    <span class="text-text">The two I’m proudest of come first, and both are playable right on this page.</span> After those come my
    backend and infrastructure work, led by KorTerra, then full stack apps and client sites.
  </p>

  <Fragment slot="after">
    <!-- Featured projects, both playable on the page: story on the left, live preview on the right. -->
    <article class="feature panel mt-14" data-peek>
      <Peeker hat="cap" />
      <div class="feature-grid">
        <div>
          <p class="meta text-sm">Dunwoody capstone, 2025</p>
          <h3 class="mt-2 font-display text-4xl font-semibold tracking-tight">DayONE</h3>
          <p class="mt-4 text-lg">
            A help site for new Dunwoody students. It collects short videos that walk you through common setup problems, sorted by platform and topic.
          </p>
          <ul class="mt-6 space-y-3 text-muted">
            <li class="fact">I wrote the application, and my teammate Lucas Kells deployed it on AWS S3.</li>
            <li class="fact">Students can register and log in, and admins get a dashboard for managing videos and categories.</li>
          </ul>
          <p class="meta mt-6 text-sm">Go ahead and use it. Log in to try the admin tools.</p>
          <div class="feature-foot">
            <p class="flex flex-wrap gap-2">
              {['JavaScript', 'Bootstrap', 'YouTube Data API', 'AWS S3'].map((t) => <span class="tag">{t}</span>)}
            </p>
            <div class="flex flex-wrap gap-3">
              <a href="/projects/dayone" class="btn btn-primary" target="_blank" rel="noopener">How I built it</a>
              <a href="https://github.com/griffinhaag/dayone" class="btn btn-ghost" target="_blank" rel="noopener">View the code</a>
            </div>
          </div>
        </div>
        <div>
          <DayOneDemo />
        </div>
      </div>
    </article>
    <article class="feature panel mt-8" data-peek>
      <Peeker hat="snapback" />
      <div class="feature-grid">
        <div>
          <p class="meta text-sm">Side project, 2025 – present</p>
          <h3 class="mt-2 font-display text-4xl font-semibold tracking-tight">GriffinGames</h3>
          <p class="mt-4 text-lg">
            Party games I made for game nights with my friends. One person puts it on the TV, and everyone else joins from their phone with a room code.
          </p>
          <ul class="mt-6 space-y-3 text-muted">
            <li class="fact">A Node and Socket.IO server keeps every screen in sync, decides who buzzed first, and lets people rejoin when their phone drops off Wi‑Fi.</li>
            <li class="fact">Typed answers are graded by an LLM, so a typo or a last name alone still counts.</li>
          </ul>
          <div class="feature-foot">
            <p class="flex flex-wrap gap-2">
              {['JavaScript', 'Node.js', 'Socket.IO', 'Express', 'Groq', 'Render', 'Netlify'].map((t) => <span class="tag">{t}</span>)}
            </p>
            <div class="flex flex-wrap gap-3">
              <a href={links.games} class="btn btn-primary" target="_blank" rel="noopener">Play my live game</a>
              <a href="/projects/griffingames" class="btn btn-ghost" target="_blank" rel="noopener">How I built it</a>
            </div>
          </div>
        </div>
        <div>
          <GamesPreview />
        </div>
      </div>
    </article>

    {groups.map((g, gi) => (
      <div class={`group ${gi ? 'mt-24' : 'mt-20'}`} id={g.id}>
        <header class="group-head">
          <p class="meta text-sm">{String(gi + 1).padStart(2, '0')}</p>
          <h3 class="font-display text-3xl font-semibold tracking-tight">{g.title}</h3>
          <p class="max-w-md text-muted">{g.blurb}</p>
        </header>
        <ul class="build-grid mt-8" data-builds>
          {g.items.map((b, i) => (
            <li class={`build-card ${i >= SHOWN ? 'extra' : ''}`}>
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-display text-lg font-medium tracking-tight">
                {b.name}
                {b.badge && <span class="badge">{b.badge}</span>}
              </p>
              <p class="mt-1 text-[0.95rem] leading-snug text-muted">{b.blurb}</p>
              <div class="mt-auto flex items-end justify-between gap-3 pt-4">
                <p class="text-xs text-muted">{b.stack.join(', ')}</p>
                {b.href && (
                  <a href={b.href} class="code-link" target="_blank" rel="noopener" aria-label={`${b.linkText === 'Visit' ? 'Visit' : 'View the code for'} ${b.name}`}>
                    {b.linkText ?? 'Code'}
                    <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 10 10 4M5 4h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
        {(g.items.length > SHOWN || gi === groups.length - 1) && (
          <div class="mt-5 flex flex-wrap gap-3">
            {g.items.length > SHOWN && (
              <button type="button" class="btn btn-ghost" data-builds-toggle aria-expanded="false">Show {g.items.length - SHOWN} more</button>
            )}
            {gi === groups.length - 1 && (
              <a href={links.github} class="btn btn-ghost" target="_blank" rel="noopener">All my code on GitHub</a>
            )}
          </div>
        )}
      </div>
    ))}
  </Fragment>
</Section>

<style>
  .feature { position: relative; padding: 1.5rem; transition: box-shadow 500ms ease; }
  .feature.peeking { box-shadow: 0 0 0 1px rgba(169, 184, 255, 0.22), 0 30px 60px -40px rgba(0, 0, 0, 0.9), 0 0 50px -20px rgba(169, 184, 255, 0.25); }
  @media (min-width: 768px) { .feature { padding: 2.25rem; } }
  .feature-grid { display: grid; gap: 2rem; }
  .feature-grid > * { min-width: 0; }
  @media (min-width: 1024px) {
    .feature-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 3rem; align-items: center; }
  }
  .feature-foot {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.25rem;
  }
  .fact { position: relative; padding-left: 1.1rem; }
  .fact::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-mist);
  }
  .build-card {
    display: flex;
    flex-direction: column;
    border-radius: 0.9rem;
    border: 1px solid var(--color-line);
    padding: 1rem 1.1rem;
    background: color-mix(in oklab, var(--color-slate) 55%, transparent);
  }
  .group-head { display: grid; gap: 0.5rem; }
  @media (min-width: 1024px) {
    /* Number and title on the left, one-line summary on the right, matching the section frame. */
    .group-head { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); column-gap: 4rem; align-items: end; }
    .group-head > .meta { grid-column: 1; }
    .group-head > h3 { grid-column: 1; }
    .group-head > p:last-child { grid-column: 2; grid-row: 1 / span 2; align-self: end; max-width: 36rem; }
  }
  .build-grid { display: grid; gap: 0.75rem; }
  /* Each group shows its first SHOWN cards; the rest open with "Show more". */
  .build-grid:not(.open) .extra { display: none; }
  @media (min-width: 640px) { .build-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .build-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .badge {
    font-family: var(--font-sans, inherit);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    padding: 0.3rem 0.5rem;
    border-radius: 999px;
    color: #f2c9d0;
    background: color-mix(in oklab, var(--color-wine) 35%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-wine) 70%, transparent);
  }
  .code-link {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    padding: 0 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text);
    transition: border-color 200ms, background-color 200ms;
  }
  @media (hover: hover) {
    .code-link:hover { border-color: var(--color-mist); background: color-mix(in oklab, var(--color-mist) 10%, transparent); }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-builds-toggle]').forEach((btn) => {
    const grid = btn.closest('.group')!.querySelector<HTMLElement>('[data-builds]')!;
    const more = btn.textContent!.trim();
    btn.addEventListener('click', () => {
      const open = grid.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Show fewer' : more;
    });
  });
</script>

<script>
  // The featured project nearest the viewport middle gets the peeker, one card at a time.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-peek]')];
  let ticking = false;
  const update = () => {
    ticking = false;
    const mid = innerHeight * 0.45;
    let best: HTMLElement | null = null;
    let bestDist = Infinity;
    for (const c of cards) {
      const r = c.getBoundingClientRect();
      // Only a card that spans the middle line counts.
      if (r.top > mid || r.bottom < mid) continue;
      const d = Math.abs(r.top + Math.min(r.height, innerHeight) / 2 - mid);
      if (d < bestDist) (best = c), (bestDist = d);
    }
    cards.forEach((c) => c.classList.toggle('peeking', c === best));
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();
</script>
