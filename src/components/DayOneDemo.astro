---
// A working miniature of DayONE: the real video list, filters, inline playback,
// and the admin tools for adding and removing videos.
import BrowserFrame from './BrowserFrame.astro';
import videos from '../data/dayone.json';

interface Props {
  tall?: boolean;
}
const { tall = false } = Astro.props;

const label = (s: string) => (s === 'n/a' ? 'Any platform' : s.replace(/\b\w/g, (c) => c.toUpperCase()));
const platforms = ['windows', 'mac', 'linux'];
const categories = [...new Set(videos.map((v) => v.category))];
---

<div class="d1-root" data-dayone data-videos={JSON.stringify(videos)}>
  <BrowserFrame url="dayone/index.html">
    <div class={`dayone flex flex-col ${tall ? 'h-[40rem]' : 'h-[31rem] sm:h-[26.5rem]'}`}>
      <header class="flex items-center justify-between gap-3 px-4 py-2.5" style="background:#800020">
        <span class="font-semibold text-white">DayONE</span>
        <div class="flex items-center gap-2">
          <span class="hidden text-xs text-white/80" data-who>Signed in as admin</span>
          <button type="button" class="d1-auth" data-auth>Log in</button>
        </div>
      </header>

      <form class="d1-admin hidden flex-wrap items-center gap-2 border-b border-[#e3c7cd] bg-[#fbf0f2] px-4 py-2.5" data-admin novalidate>
        <label for="d1-url" class="text-xs font-semibold text-[#5a0016]">Add a video</label>
        <input id="d1-url" class="d1-input min-w-0 flex-1 basis-40" placeholder="Paste a YouTube link" data-url autocomplete="off" />
        <select class="d1-input" data-new-platform aria-label="Platform for the new video">
          {platforms.map((p) => <option value={p}>{label(p)}</option>)}
          <option value="n/a">Any platform</option>
        </select>
        <button type="submit" class="d1-add">Add</button>
        <p class="basis-full text-xs text-[#5a0016]" data-admin-msg aria-live="polite">Paste any YouTube link. You can also remove videos with the × on each card.</p>
      </form>

      <div class="space-y-2 px-4 pt-3 pb-2.5">
        <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Platform">
          <button type="button" class="d1-chip" data-platform="" aria-pressed="true">All</button>
          {platforms.map((p) => <button type="button" class="d1-chip" data-platform={p} aria-pressed="false">{label(p)}</button>)}
          <label class="sr-only" for={`d1-search-${tall ? 't' : 's'}`}>Search videos</label>
          <input id={`d1-search-${tall ? 't' : 's'}`} data-q type="search" placeholder="Search" class="d1-input ml-auto w-full min-w-0 sm:w-40" />
        </div>
        <div class="d1-cats flex gap-1.5 overflow-x-auto" role="group" aria-label="Category">
          <button type="button" class="d1-chip d1-chip-cat" data-category="" aria-pressed="true">All topics</button>
          {categories.map((c) => <button type="button" class="d1-chip d1-chip-cat" data-category={c} aria-pressed="false">{label(c)}</button>)}
        </div>
      </div>

      <p class="px-4 pb-1.5 text-xs text-[#495057]" data-count aria-live="polite"></p>
      <ul class="grid min-h-0 flex-1 auto-rows-min grid-cols-2 gap-3 overflow-y-auto px-4 pb-4 sm:grid-cols-3" data-grid></ul>
    </div>
  </BrowserFrame>
</div>

<style>
  .dayone { background: #f2f2f2; color: #212529; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; }
  .d1-input { height: 2rem; border: 1px solid #ced4da; border-radius: 0.375rem; background: #fff; color: #212529; padding: 0 0.6rem; font-size: 0.8rem; }
  .d1-input:focus-visible, .dayone button:focus-visible { outline: 2px solid #800020; outline-offset: 1px; }
  .d1-chip {
    flex: none;
    height: 1.75rem;
    border-radius: 999px;
    border: 1px solid #ced4da;
    background: #fff;
    padding: 0 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #495057;
    transition: background-color 150ms, color 150ms, border-color 150ms;
  }
  .d1-chip:hover { border-color: #800020; color: #800020; }
  .d1-chip[aria-pressed='true'] { background: #800020; border-color: #800020; color: #fff; }
  .d1-chip-cat[aria-pressed='true'] { background: #343a40; border-color: #343a40; }
  .d1-cats { scrollbar-width: none; }
  .d1-cats::-webkit-scrollbar { display: none; }
  .d1-auth { border-radius: 0.375rem; background: #212529; padding: 0.3rem 0.7rem; font-size: 0.75rem; color: #fff; }
  .d1-auth:hover { background: #000; }
  .d1-add { height: 2rem; border-radius: 0.375rem; background: #800020; padding: 0 0.9rem; font-size: 0.8rem; font-weight: 600; color: #fff; }
  .d1-add:hover { background: #a0002c; }

  :global(.d1-card) { position: relative; display: flex; flex-direction: column; overflow: hidden; border-radius: 0.375rem; background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08); }
  :global(.d1-thumb) { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; background: #212529; overflow: hidden; }
  :global(.d1-thumb img) { width: 100%; height: 100%; object-fit: cover; transition: transform 300ms ease; }
  :global(.d1-thumb:hover img) { transform: scale(1.04); }
  :global(.d1-play) { position: absolute; inset: 0; margin: auto; width: 2.4rem; height: 1.7rem; border-radius: 0.45rem; background: rgba(0, 0, 0, 0.7); display: grid; place-items: center; transition: background-color 150ms; }
  :global(.d1-thumb:hover .d1-play) { background: #c4302b; }
  :global(.d1-card iframe) { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; }
  :global(.d1-title) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; font-size: 0.72rem; font-weight: 600; line-height: 1.25; color: #212529; }
  :global(.d1-badges) { display: flex; gap: 0.25rem; margin-top: 0.4rem; overflow: hidden; }
  :global(.d1-badge) { flex: none; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-radius: 0.25rem; padding: 0.15rem 0.35rem; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; color: #fff; }
  :global(.d1-remove) { position: absolute; top: 0.3rem; right: 0.3rem; z-index: 1; width: 1.4rem; height: 1.4rem; border-radius: 50%; background: rgba(0, 0, 0, 0.75); color: #fff; font-size: 0.85rem; line-height: 1; display: grid; place-items: center; }
  :global(.d1-remove:hover) { background: #c4302b; }
  :global(.d1-new) { animation: d1-in 400ms cubic-bezier(0.22, 1, 0.36, 1); box-shadow: 0 0 0 2px #800020; }
  @keyframes d1-in { from { opacity: 0; transform: scale(0.94); } }
  @media (prefers-reduced-motion: reduce) { :global(.d1-new) { animation: none; } }
  /* Touch screens: finger-sized targets, and 16px inputs so iPhones don't zoom the page on focus. */
  @media (pointer: coarse) {
    .d1-input { height: 2.5rem; font-size: 16px; }
    .d1-chip { height: 2.25rem; padding: 0 0.85rem; }
    .d1-auth { padding: 0.55rem 0.9rem; }
    .d1-add { height: 2.5rem; }
    :global(.d1-remove) { width: 2rem; height: 2rem; }
  }
</style>

<script>
  type Video = { id: string; title: string; platform: string; category: string; added?: boolean };
  const label = (s: string) => (s === 'n/a' ? 'Any platform' : s.replace(/\b\w/g, (c) => c.toUpperCase()));
  const ytId = (url: string) => {
    const m = url.trim().match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/))([\w-]{11})/) || url.trim().match(/^([\w-]{11})$/);
    return m ? m[1] : null;
  };

  document.querySelectorAll<HTMLElement>('[data-dayone]').forEach((root) => {
    let videos: Video[] = JSON.parse(root.dataset.videos!);
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const admin = root.querySelector<HTMLFormElement>('[data-admin]')!;
    const authBtn = root.querySelector<HTMLButtonElement>('[data-auth]')!;
    const who = root.querySelector<HTMLElement>('[data-who]')!;
    const msg = root.querySelector<HTMLElement>('[data-admin-msg]')!;
    let platform = '';
    let category = '';
    let isAdmin = false;
    let playing: string | null = null;

    function card(v: Video) {
      const li = document.createElement('li');
      li.className = `d1-card${v.added ? ' d1-new' : ''}`;
      const media =
        playing === v.id
          ? `<iframe src="https://www.youtube-nocookie.com/embed/${v.id}?autoplay=1&rel=0" title="${v.title.replace(/"/g, '&quot;')}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`
          : `<button type="button" class="d1-thumb" data-play="${v.id}" aria-label="Play ${v.title.replace(/"/g, '&quot;')}">
               <img src="https://i.ytimg.com/vi/${v.id}/mqdefault.jpg" alt="" width="320" height="180" loading="lazy" />
               <span class="d1-play"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" fill="#fff"/></svg></span>
             </button>`;
      li.innerHTML = `${media}
        <div class="p-2">
          <p class="d1-title"></p>
          <p class="d1-badges">
            <span class="d1-badge" style="background:#6c757d">${label(v.platform)}</span>
            <span class="d1-badge" style="background:#212529">${v.category}</span>
          </p>
        </div>
        ${isAdmin ? `<button type="button" class="d1-remove" data-remove="${v.id}" aria-label="Remove ${v.title.replace(/"/g, '&quot;')}">×</button>` : ''}`;
      li.querySelector('.d1-title')!.textContent = v.title;
      return li;
    }

    function render() {
      const term = q.value.trim().toLowerCase();
      const list = videos.filter(
        (v) =>
          (!platform || v.platform === platform || v.platform === 'n/a') &&
          (!category || v.category === category) &&
          (!term || v.title.toLowerCase().includes(term)),
      );
      grid.innerHTML = '';
      list.forEach((v) => grid.appendChild(card(v)));
      if (!list.length) {
        const li = document.createElement('li');
        li.className = 'col-span-full py-10 text-center text-sm text-[#495057]';
        li.textContent = 'No videos match. Try another platform or topic, or clear the search.';
        grid.appendChild(li);
      }
      count.textContent = `${list.length} of ${videos.length} videos`;
      videos.forEach((v) => delete v.added);
    }

    const pressGroup = (attr: string, value: string) =>
      root.querySelectorAll<HTMLButtonElement>(`[${attr}]`).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value)));
    root.querySelectorAll<HTMLButtonElement>('[data-platform]').forEach((b) =>
      b.addEventListener('click', () => {
        platform = b.dataset.platform!;
        pressGroup('data-platform', platform);
        render();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((b) =>
      b.addEventListener('click', () => {
        category = b.dataset.category!;
        pressGroup('data-category', category);
        render();
      }),
    );
    q.addEventListener('input', render);

    // Click a thumbnail to play it in place. Only one video plays at a time.
    grid.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const play = t.closest<HTMLElement>('[data-play]');
      const remove = t.closest<HTMLElement>('[data-remove]');
      if (play) {
        playing = play.dataset.play!;
        render();
      } else if (remove) {
        const v = videos.find((x) => x.id === remove.dataset.remove);
        videos = videos.filter((x) => x.id !== remove.dataset.remove);
        if (playing === v?.id) playing = null;
        msg.textContent = `Removed “${v?.title}”.`;
        render();
      }
    });

    // Log in is simulated, like the real static site: it just switches to the admin view.
    authBtn.addEventListener('click', () => {
      isAdmin = !isAdmin;
      authBtn.textContent = isAdmin ? 'Log out' : 'Log in';
      who.classList.toggle('hidden', !isAdmin);
      who.classList.toggle('sm:inline', isAdmin);
      admin.classList.toggle('hidden', !isAdmin);
      admin.classList.toggle('flex', isAdmin);
      render();
      if (isAdmin) admin.querySelector<HTMLInputElement>('[data-url]')!.focus();
    });

    admin.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = admin.querySelector<HTMLInputElement>('[data-url]')!;
      const id = ytId(input.value);
      if (!id) {
        msg.textContent = 'That doesn’t look like a YouTube link. Try one like youtube.com/watch?v=…';
        return;
      }
      if (videos.some((v) => v.id === id)) {
        msg.textContent = 'That video is already in the library.';
        return;
      }
      msg.textContent = 'Looking up the title…';
      let title = 'New video';
      try {
        const r = await fetch(`https://noembed.com/embed?url=https://www.youtube.com/watch?v=${id}`);
        const j = await r.json();
        if (j.title) title = j.title;
      } catch {
        /* keep the placeholder title */
      }
      const p = admin.querySelector<HTMLSelectElement>('[data-new-platform]')!.value;
      videos.unshift({ id, title, platform: p, category: 'general', added: true });
      platform = '';
      category = '';
      q.value = '';
      pressGroup('data-platform', '');
      pressGroup('data-category', '');
      input.value = '';
      msg.textContent = `Added “${title}”. It’s at the top of the library.`;
      grid.scrollTop = 0;
      render();
    });

    render();
  });
</script>
